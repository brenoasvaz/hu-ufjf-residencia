# ─── Banco de dados ───────────────────────────────────────────────────────────
# String de conexão MySQL compatível (TiDB Cloud, PlanetScale, MySQL 8+)
DATABASE_URL=mysql://user:password@host:4000/hu_ufjf?ssl={"rejectUnauthorized":true}

# ─── Autenticação ─────────────────────────────────────────────────────────────
# Segredo para assinar os JWTs de sessão (mínimo 32 caracteres aleatórios)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ID da aplicação — usado como claim "appId" no JWT (pode ser qualquer string)
VITE_APP_ID=hu-ufjf-residencia

# openId do admin principal (e-mail usado no login interno)
OWNER_OPEN_ID=admin@example.com

# ─── Cloudflare R2 (armazenamento de arquivos) ────────────────────────────────
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=hu-ufjf-arquivos

# ─── Ambiente ─────────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── Porta (opcional — Render define PORT automaticamente) ────────────────────
# PORT=3000
